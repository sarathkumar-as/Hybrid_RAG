OPENAI_API_KEY=replace-with-your-openai-api-key
NEO4J_PASSWORD=replace-with-a-long-unique-password
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
MAX_UPLOAD_MB=20
MAX_PAGES=100
MAX_CHUNKS=150
# Set a long random secret in your private .env to enable document deletion.
# Viewing the public website does not need this secret.
ADMIN_DELETE_TOKEN=
# VPS only: set your own hostname and login before using docker-compose.vps.yml.
RAG_DOMAIN=rag.example.com
RAG_USER=ragadmin
# Paste a Caddy-generated hash inside single quotes so Compose preserves $ characters.
RAG_PASSWORD_HASH='replace-with-caddy-password-hash'
# Existing Traefik deployment is public; keep ADMIN_DELETE_TOKEN private.
